VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws
VITE_SPLASH_DURATION_MS=2200

GO_HTTP_ADDR=:8080
GO_ALLOWED_ORIGIN=http://localhost:5173
GO_DEV_IN_MEMORY=true
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=
# Compose database address; use localhost for a separately configured local DB.
# URL-encode special characters in the password in this DSN.
POSTGRES_DSN=

PYTHON_HTTP_PORT=8000
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_INIT_DATA_MAX_AGE=86400
ADMIN_API_TOKEN=replace_with_a_long_random_admin_token
TELEGRAM_ADMIN_IDS=
# Trust only immediate ingress IPs which overwrite X-Real-IP. Empty trusts none.
TRUSTED_PROXY_CIDRS=
API_ENABLE_DOCS=false
MINI_APP_LINK=https://t.me/your_bot/your_app
